# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
# Required to register as an admin from /register
ADMIN_INVITE_CODE="replace-with-a-secret-code"

# Open complaints older than this many days are flagged as overdue
OVERDUE_THRESHOLD_DAYS=5

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="Maple Residency <user@example.com>"
